{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "b=\"$(\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codeeval-bin.sh)\"; [ -z \"$b\" ] || CODEEVAL_BIN=\"$b\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codeeval-session-base.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "b=\"$(\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codeeval-bin.sh)\"; [ -z \"$b\" ] || CODEEVAL_BIN=\"$b\" \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codeeval-stop-analyze.sh",
            "timeout": 180,
            "type": "command"
          }
        ]
      }
    ]
  }
}
