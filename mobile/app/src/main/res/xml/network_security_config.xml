<?xml version="1.0" encoding="utf-8"?>
<!-- Legato serves plain HTTP on the local network by default, and its HTTPS
     certificates come from a CA the person installs on the phone. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
