{
  "expo": {
    "name": "Legato",
    "slug": "legato-mobile",
    "version": "1.0.0",
    "scheme": "legato",
    "icon": "./assets/icon.png",
    "backgroundColor": "#09090b",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/legato-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "dev.legato.mobile",
      "backgroundColor": "#09090b",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-camera", {"cameraPermission": "Scan Legato pairing QR codes", "recordAudioAndroid": false}],
      "expo-secure-store",
      ["expo-navigation-bar", {
        "backgroundColor": "#09090b",
        "barStyle": "light",
        "borderColor": "#09090b",
        "visibility": "visible",
        "position": "relative"
      }],
      "./plugins/withUserCertificateTrust"
    ]
  }
}
