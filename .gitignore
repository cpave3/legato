bin/
/legato
*.db
*.sqlite
.DS_Store
internal/server/static/dist/*
!internal/server/static/dist/.gitkeep
web/node_modules/
mobile/*.apk
browser-extension/node_modules/
browser-extension/dist/
browser-extension/coverage/

# Swarm runtime artifacts (per-agent briefs, plan YAMLs)
.legato/

# Scratch plan files at repo root
/plan.yaml
/fix-plan.yaml
/swarm-plan.yaml
/swarm-*-plan.yaml
/plan-test-*.yaml

# Working outputs agents and workflows write at the root (task-triage reports,
# swarm summaries); they belong in the task's notes, not the tree
/task-triage-*.md
/summary-*.md

# pnpm makes its store here because the repo is its own mount
/.pnpm-store/

# Release binaries (task release:dist)
/dist/
.task/

# Apps under packages/: dependencies, builds, packed .ehpk files, pack
# scratch, and local settings (a Legato address and token): every .env file
# Vite reads, but the example
/packages/**/node_modules/
/packages/**/dist/
/packages/**/.pack/
/packages/**/.env*
!/packages/**/.env.example

# Agents' scratch files (screenshots, notes), never committed
.scratch/
.tmp/
