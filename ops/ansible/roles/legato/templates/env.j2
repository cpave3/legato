# Read by legato.service (EnvironmentFile). Everything here reaches every
# agent, so put nothing in it an agent may not use. Written once by Legato's
# Ansible role; it never overwrites this file.
{% for name, value in legato_env | dictsort %}
{{ name }}={{ value }}
{% endfor %}
{% if legato_rust_build_cache and 'sccache' in legato_mise_tools %}
# Rust inside the sandbox, which does not see ~/.cargo/config.toml.
RUSTC_WRAPPER=sccache
{% endif %}
{% if 'dotnet' in legato_mise_tools %}
DOTNET_ROOT={{ legato_home }}/.local/share/mise/dotnet-root
{% endif %}

# Claude Code without a login in ~/.claude: `claude setup-token` prints a
# long-lived token for your subscription.
# CLAUDE_CODE_OAUTH_TOKEN=

# Codex with an API key instead of `codex login --device-auth`:
# OPENAI_API_KEY=
