{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The shell (title bar, dock, panels) may call every app command and move its window. Server pages, which are remote, get nothing.",
  "webviews": ["shell"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-servers",
    "allow-show-server",
    "allow-page-approval-done",
    "allow-open-approval-in-page",
    "allow-page-trusted",
    "allow-trust-server-certificate",
    "allow-save-server-certificate",
    "allow-open-certificate",
    "allow-set-content-visible",
    "allow-reload-server",
    "allow-load-server-page",
    "allow-pair-server",
    "allow-discovered",
    "allow-rename-server",
    "allow-remove-server",
    "allow-reorder-servers",
    "allow-poll",
    "allow-keys",
    "allow-add-key",
    "allow-touch-id",
    "allow-add-touch-id",
    "allow-enroll-key",
    "allow-revoke-key",
    "allow-prepare",
    "allow-sign",
    "allow-deny",
    "allow-check-update",
    "allow-apply-update",
    "allow-restart-app",
    "allow-take-import-requests",
    "allow-import-preference",
    "allow-set-import-preference",
    "allow-import-ticket",
    "allow-open-task-in-page",
    "allow-voice-key-info",
    "allow-change-voice-key",
    "allow-set-hold-to-talk",
    "allow-voice-targets",
    "allow-set-voice-server",
    "allow-voice-action",
    "allow-voice-status",
    "allow-voice-open-settings",
    "allow-voice-widget-size",
    "allow-voice-widget-menu",
    "allow-voice-widget-settings",
    "allow-set-voice-widget"
  ]
}
