# Copy to .env.local (gitignored) to read a Legato instead of the fixture.
# Use a scratch Legato for development, not the one you work in.
# LEGATO_URL=https://127.0.0.1:3999
# LEGATO_TOKEN=
# Pass dictated messages on to that Legato's agents (the dev server refuses
# them otherwise). Only for a scratch Legato whose agents you mean to message:
# LEGATO_ALLOW_SEND=1
# A fixture other than fixtures/agents.json:
# LEGATO_FIXTURE=fixtures/empty.json
